SQL> DECLARE
  2      rollno       NUMBER;
  3      name         VARCHAR2(50);
  4      mark1        NUMBER;
  5      mark2        NUMBER;
  6      mark3        NUMBER;
  7      total        NUMBER;
  8      percentage   NUMBER;
  9      class        VARCHAR2(20);
 10  BEGIN
 11      rollno := &rollno;
 12      name := '&name';
 13      mark1 := &mark1;
 14      mark2 := &mark2;
 15      mark3 := &mark3;
 16  
 17      total := mark1 + mark2 + mark3;
 18      percentage := total / 3;
 19  
 20      IF percentage >= 60 THEN
 21          class := 'First Class';
 22      ELSIF percentage >= 50 THEN
 23          class := 'Second Class';
 24      ELSIF percentage >= 40 THEN
 25          class := 'Third Class';
 26      ELSE
 27          class := 'Fail';
 28      END IF;
 29  
 30      DBMS_OUTPUT.PUT_LINE('Roll No    : ' || rollno);
 31      DBMS_OUTPUT.PUT_LINE('Name       : ' || name);
 32      DBMS_OUTPUT.PUT_LINE('Total      : ' || total);
 33      DBMS_OUTPUT.PUT_LINE('Percentage : ' || percentage || '%');
 34      DBMS_OUTPUT.PUT_LINE('Class      : ' || class);
 35  END;
 36  /
