#include<iostream.h>
#include<conio.h>

void main ()
{
	int a,b;
	char c;
	clrscr();
	cout<<"Enter value for A :";
	cin>>a;
	cout<<"Enter value for B :";
	cin>>b;
	cout<<"Enter Operator (+,-,*,/):";
	cin>>c;

	if(c == '+')
	{
		cout<<"Ans is :"<<a + b;
	}
	else if(c == '-')
	{
		cout<<"Ans is :"<<a - b;
	}
	else if(c == '*')
	{
		cout<<"Ans is :"<<a * b;
	}
	else if(c == '/')
	{
		cout<<"Ans is :"<<a /b;
	}
	else
	{
		cout<<"Invalid Operator";
	}
	getch();
}