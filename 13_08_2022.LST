SQL> DECLARE
  2      n NUMBER;
  3      a NUMBER := 0;
  4      b NUMBER := 1;
  5      c NUMBER;
  6  BEGIN
  7      n := &n;
  8  
  9      DBMS_OUTPUT.PUT(a || ' ' || b || ' ');
 10  
 11      c := a + b;
 12  
 13      WHILE c <= n LOOP
 14          DBMS_OUTPUT.PUT(c || ' ');
 15          a := b;
 16          b := c;
 17          c := a + b;
 18      END LOOP;
 19  
 20      DBMS_OUTPUT.NEW_LINE;
 21  END;
 22  /
Enter value for n: 5
old   7:     n := &n;
new   7:     n := 5;

PL/SQL procedure successfully completed.

SQL> DECLARE
  2      n NUMBER;
  3      i NUMBER := 1;
  4      fact NUMBER := 1;
  5  BEGIN
  6      n := &n;
  7  
  8      WHILE i <= n LOOP
  9          fact := fact * i;
 10          i := i + 1;
 11      END LOOP;
 12  
 13      DBMS_OUTPUT.PUT_LINE('Factorial = ' || fact);
 14  END;
 15  /
Enter value for n: 6
old   6:     n := &n;
new   6:     n := 6;

