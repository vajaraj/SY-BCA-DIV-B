SQL> SELECT o.ord_id,
  2         o.purchase_amt,
  3         c.cname AS customer_name,
  4         c.city AS customer_city,
  5         s.name AS salesman_name,
  6         s.city AS salesman_city
  7  FROM Orders o
  8  JOIN Customer c
  9    ON o.cust_id = c.cust_id
 10  JOIN Salesman s
 11    ON o.salesman_id = s.salesman_id
 12  WHERE c.city <> s.city;

