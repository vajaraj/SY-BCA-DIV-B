SQL> SELECT
  2      e.Emp_name,
  3      d.Dept_name,
  4      (s.Sal + s.HRA + s.MA - s.PF) AS Total_Salary
  5  FROM Emp_mast e
  6  JOIN Dept_mast d
  7      ON e.Dept_code = d.Dept_no
  8  JOIN Salary_mast s
  9      ON e.Emp_no = s.Emp_no
 10  WHERE s.Sal > 2000
 11    AND s.Sal < 5000;

