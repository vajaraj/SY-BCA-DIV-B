SQL> SELECT d.deptname,
  2         COUNT(e.Emp_id) AS employee_count
  3  FROM Emp_department d
  4  JOIN Emp_details e
  5    ON d.dept_no = e.dept_no
  6  GROUP BY d.dept_no, d.deptname
  7  HAVING COUNT(e.Emp_id) > 2;

DEPTNAME                                           EMPLOYEE_COUNT               
-------------------------------------------------- --------------               
IT                                                              3               

