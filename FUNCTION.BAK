//function overloading

#include<iostream.h>
#include<conio.h>
int add(int x,int y);
int add(int x,int y, int z);
void main()
{
	int a,b,c,d;
	clrscr();
	cout<<"Enter Three Number:";
	cin>>a>>b>>c;
	d=add(a,b);
	cout<<"\n Sum Of Two Argument Function :"<<d;
	d=add(a,b,c);
	cout<<"\n Sum Of Three Argument Function :"<<d;
	getch();
}
int add(int x,int y)
{
	return (x+y);
}
int add(int x,int y, int z)
{
	return (x+y+z);
}