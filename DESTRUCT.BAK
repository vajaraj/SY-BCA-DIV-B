// EXAMPLE OF DESTRUCTOR
#include<iostream.h>
#include<conio.h>
class A
{
	static int  a;
	public :
		A()
		{
			cout<<"\n OBJECT CREATED :"<<++a;
		}
	       ~A()
		{
			cout<<"\n OBJECT DESTRUCTEY :"<<a--;
		}
};
int A :: a;
void main()
{
	clrscr();
	A a1;
	A a2;
	{
		A a3;
	}
	A a4;
	{
		A a5;
	}
	A a6;
		getch();
}