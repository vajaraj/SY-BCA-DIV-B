SQL> CREATE TABLE Orders (    ord_id INT PRIMARY KEY,    purchase_amt DECIMAL(10,2),    order_date DATE,    cust_id INT,    salesman_id INT,    FOREIGN KEY (cust_id) REFERENCES Customer(cust_id),    FOREIGN KEY (salesman_id) REFERENCES Salesman(salesman_id));

Table created.

SQL> desc orders;
