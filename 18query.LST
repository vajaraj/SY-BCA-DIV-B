SQL> CREATE TABLE Item_Master (    Item_id NUMBER PRIMARY KEY,    Item_name VARCHAR2(50),    price NUMBER(10,2),    company_code NUMBER,    FOREIGN KEY (company_code) REFERENCES Company_master(Com_id));

Table created.

