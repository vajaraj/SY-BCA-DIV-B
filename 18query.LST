SQL> SELECT c.com_name, AVG(i.price) AS average_price
  2  FROM Company_master c
  3  JOIN Item_Master i
  4  ON c.Com_id = i.company_code
  5  GROUP BY c.com_name;

COM_NAME                                           AVERAGE_PRICE                
-------------------------------------------------- -------------                
Samsung                                                      200                
Apple                                                        650                
Dell                                                         350                
HP                                                           450                

SQL> SELECT c.com_name, AVG(i.price) AS average_price
  2  FROM Company_master c
  3  JOIN Item_Master i
  4  ON c.Com_id = i.company_code
  5  GROUP BY c.com_name
  6  HAVING AVG(i.price) >= 350;

COM_NAME                                           AVERAGE_PRICE                
-------------------------------------------------- -------------                
Apple                                                        650                
Dell                                                         350                
HP                                                           450                

