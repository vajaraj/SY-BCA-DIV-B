#include<iostream.h>
#include<conio.h>
class Demo
{
	int a ;
	float b;
	char c;
	public :
		void get()
		{
			cout<<"ENTER AN INT A ,FLOAT B AND CHAR C :";
			cin>>a>>b>>c;
		}
		void put();
};
void Demo :: put()
{
	cout<<"\n A="<<a;
	cout<<"\n B="<<b;
	cout<<"\n C="<<c;
}
void main()
{
	Demo d1;
	clrscr();
	d1.get();
	d1.put();
