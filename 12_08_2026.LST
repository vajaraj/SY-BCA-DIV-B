CREATE TABLE Customer(    cust_id INT PRIMARY KEY,    cname VARCHAR(50),    city VARCHAR(50),    grade INT,    salesman_id INT,    FOREIGN KEY (salesman_id) REFERENCES Salesman(salesman_id));

Table created.

SQL> desc customer;
 Name                                      Null?    Type
 ----------------------------------------- -------- ----------------------------
 CUST_ID                                   NOT NULL NUMBER(38)
 CNAME                                              VARCHAR2(50)
 CITY                                               VARCHAR2(50)
 GRADE                                              NUMBER(38)
 SALESMAN_ID                                        NUMBER(38)

