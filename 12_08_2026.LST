SQL> SELECT o.ord_id AS order_no,
  2         c.cname AS customer_name,
  3         s.commission AS commission_rate,
  4         o.purchase_amt * s.commission AS earned_commission
  5  FROM Orders o
  6  JOIN Customer c
  7    ON o.cust_id = c.cust_id
  8  JOIN Salesman s
  9    ON o.salesman_id = s.salesman_id
 10  WHERE c.grade >= 200;

